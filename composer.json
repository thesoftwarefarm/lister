{
    "name": "tsfcorp/lister",
    "type": "library",
    "description": "Listing library for Laravel",
    "keywords": [
        "laravel",
        "listing",
        "php"
    ],
    "homepage": "https://github.com/tsfcop/lister",
    "license": "MIT",
    "authors": [
        {
            "name": "Emi Polak",
            "email": "emi.tsf@gmail.com"
        },
        {
            "name": "Marian Perca",
            "email": "marian.perca@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.1",
        "laravel/framework": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "TsfCorp\\Lister\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TsfCorp\\Lister\\Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true
    },

    "extra": {
        "laravel": {
            "providers": [
                "TsfCorp\\Lister\\ListerServiceProvider"
            ],
            "aliases": {
                "Lister": "TsfCorp\\Lister\\Facades\\Lister",
                "ListerFilter": "TsfCorp\\Lister\\Facades\\ListerFilter"
            }
        }
    }
}
